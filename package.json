{
  "name": "tguard-js",
  "description": "Predictable runtime type guards and structural narrowing where TypeScript compile-time inferences cannot reach.",
  "version": "1.1.0-dev0",
  "type": "commonjs",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils/index.js"
  },
  "scripts": {
    "clean": "rimraf dist/",
    "build": "tsc --build",
    "build:force": "npm run clean && npm run build -- --force",
    "postbuild": "npm run scripts/postbuild.mjs",
    "format": "prettier --write --cache --cache-location .prettiercache src/ tests/",
    "test": "jest --config jest.config.js",
    "coverage": "jest --config jest.config.js --coverage"
  },
  "devDependencies": {
    "@tsconfig/node14": "^14.1.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "jest": "^30.3.0",
    "prettier": "^3.8.2",
    "rimraf": "^6.1.3",
    "strip-comments": "^2.0.1",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2"
  },
  "license": "MIT",
  "author": "Ryuu Mitsuki (https://github.com/mitsuki31)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsuki31/tguard-js.git"
  },
  "funding": "https://github.com/mitsuki31/tguard-js?sponsor=1",
  "engines": {
    "node": ">=14.13"
  },
  "homepage": "https://github.com/mitsuki31/tguard-js#readme",
  "keywords": [
    "typescript",
    "typeguard",
    "type-guard",
    "runtime-validation",
    "data-validation",
    "schema-validation",
    "runtime-type-checking",
    "type-safety",
    "zero-dependency",
    "cross-realm",
    "validator",
    "assertion",
    "node",
    "browser"
  ]
}
